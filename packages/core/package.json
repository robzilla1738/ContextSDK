{
  "name": "@contextsdk/core",
  "version": "0.2.0",
  "description": "Portable encrypted context state for AI sandboxes and VMs",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robzilla1738/ContextSDK.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/robzilla1738/ContextSDK#readme",
  "bugs": {
    "url": "https://github.com/robzilla1738/ContextSDK/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "sandbox",
    "filesystem",
    "persistence",
    "context"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.940.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
