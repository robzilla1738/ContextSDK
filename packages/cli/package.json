{
  "name": "@contextsdk/cli",
  "version": "0.2.0",
  "description": "CLI for portable encrypted context state",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robzilla1738/ContextSDK.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/robzilla1738/ContextSDK#readme",
  "bugs": {
    "url": "https://github.com/robzilla1738/ContextSDK/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "sandbox",
    "filesystem",
    "persistence",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "contextsdk": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@contextsdk/adapter-e2b": "^0.2.0",
    "@contextsdk/adapter-modal": "^0.2.0",
    "@contextsdk/adapter-vercel": "^0.2.0",
    "@contextsdk/core": "^0.2.0",
    "commander": "^14.0.2",
    "jiti": "^2.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
